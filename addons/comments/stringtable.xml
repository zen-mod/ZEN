<?xml version="1.0" encoding="utf-8"?>
<Project name="ZEN">
    <Package name="Comments">
        <Key ID="STR_ZEN_Comments_Enabled">
            <English>Enable Comments in Zeus</English>
            <German>Aktiviere Kommentare im Zeus</German>
            <French>Activer les commentaires dans Zeus</French>
            <Japanese>Zeus でコメントを有効にする</Japanese>
            <Spanish>Activar los comentarios en Zeus</Spanish>
        </Key>
        <Key ID="STR_ZEN_Comments_Enabled_Description">
            <English>Enables creating comments in Zeus.</English>
            <German>Erlaube das Erstellen von Kommentaren im Zeus.</German>
            <French>Autoriser la création de commentaires dans Zeus.</French>
            <Japanese>Zeus でコメントを作成できるようにします。</Japanese>
            <Spanish>Permite crear comentarios en Zeus.</Spanish>
        </Key>
        <Key ID="STR_ZEN_Comments_Enabled3DEN">
            <English>Show 3DEN Comments in Zeus</English>
            <German>Zeige 3DEN-Kommentare im Zeus</German>
            <French>Afficher les commentaires 3DEN dans Zeus</French>
            <Japanese>Zeus で 3DEN コメントを表示します</Japanese>
            <Spanish>Mostrar los comentarios de 3DEN en Zeus</Spanish>
        </Key>
        <Key ID="STR_ZEN_Comments_Enabled3DEN_Description">
            <English>Controls whether comments placed in 3DEN are shown in Zeus.</English>
            <German>Zeige 3DEN-Kommentare im Zeus an.</German>
            <French>Afficher les commentaires 3DEN dans Zeus.</French>
            <Japanese>Zeus で 3DEN コメントを表示します。</Japanese>
            <Spanish>Muestra los comentarios de 3DEN en Zeus.</Spanish>
        </Key>
        <Key ID="STR_ZEN_Comments_ColorDefault">
            <English>Default Comment Color</English>
        </Key>
        <Key ID="STR_ZEN_Comments_ColorDefault_Description">
            <English>Controls the default color of comments created in Zeus.</English>
        </Key>
        <Key ID="STR_ZEN_Comments_Color3DEN">
            <English>3DEN Comment Color</English>
            <German>Farbe der 3DEN-Kommentare</German>
            <French>Couleur du commentaire 3DEN</French>
            <Japanese>3DEN コメントの色</Japanese>
            <Spanish>Color de los comentarios de 3DEN</Spanish>
        </Key>
        <Key ID="STR_ZEN_Comments_Color3DEN_Description">
            <English>Controls the color of 3DEN comments shown in Zeus.</English>
            <German>Farbe der 3DEN-Kommentare im Zeus.</German>
            <French>Couleur des commentaires 3DEN dans Zeus.</French>
            <Japanese>Zeus での 3DEN コメントの色。</Japanese>
            <Spanish>Color de los comentarios de 3DEN en Zeus.</Spanish>
        </Key>
        <Key ID="STR_ZEN_Comments_AllowDeleting3DEN">
            <English>Allow Deleting 3DEN Comments</English>
            <German>Erlaube Löschen von 3DEN-Kommentaren</German>
            <French>Autoriser la suppression des commentaires 3DEN</French>
            <Japanese>3DEN コメントの削除を許可します</Japanese>
            <Spanish>Permitir eliminar los comentarios de 3DEN</Spanish>
        </Key>
        <Key ID="STR_ZEN_Comments_AllowDeleting3DEN_Description">
            <English>Allows comments placed in 3DEN to be deleted in Zeus.</English>
            <German>Erlaube jedem Zeus das Löschen von 3DEN-Kommentaren.</German>
            <French>Autoriser tout Zeus à supprimer les commentaires 3DEN.</French>
            <Japanese>すべての Zeus で 3DEN コメントを削除できるようにします。</Japanese>
            <Spanish>Permite que cualquier Zeus elimine los comentarios de 3DEN.</Spanish>
        </Key>
        <Key ID="STR_ZEN_Comments_ShowCommentInZeus">
            <English>Show Comment in Zeus</English>
            <German>Zeige Kommentar in Zeus</German>
            <French>Show comment in Zeus</French>
            <Japanese>Zeus でコメントを表示します</Japanese>
            <Spanish>Mostrar el comentario en Zeus</Spanish>
        </Key>
        <Key ID="STR_ZEN_Comments_ShowCommentInZeus_Description">
            <English>Controls whether this comment will be shown in Zeus.</English>
            <German>Wenn ausgewählt, wird dieser Kommentar in Zeus angezeigt.</German>
            <French>Si sélectionné, ce commentaire sera affiché dans Zeus.</French>
            <Japanese>選択すると、このコメントが Zeus に表示されます。</Japanese>
            <Spanish>Si se marca, este comentario se mostrará en Zeus.</Spanish>
        </Key>
        <Key ID="STR_ZEN_Comments_EditComment">
            <English>Edit Comment</English>
        </Key>
        <Key ID="STR_ZEN_Comments_LockPosition">
            <English>Lock Position</English>
            <German>Position sperren</German>
            <French>Verrouiller la position</French>
            <Japanese>位置をロック</Japanese>
            <Spanish>Bloquear la posición</Spanish>
        </Key>
        <Key ID="STR_ZEN_Comments_LockPosition_Description">
            <English>Prevents the comment from being moved by dragging its icon.</English>
        </Key>
    </Package>
</Project>
